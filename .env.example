# Canonical site URL used in metadata, sitemap and JSON-LD (defaults to the Vercel production URL).
NEXT_PUBLIC_SITE_URL=https://lotlizard.example

# Community submissions are OFF on every deployment until ALL of these are set:
#   SUBMISSIONS_ENABLED=true, UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN (persistent storage and
#   shared rate limiting), and ADMIN_TOKEN of 32+ characters. Enforced server-side by /api/submissions.
SUBMISSIONS_ENABLED=

# Required to use /admin moderation. Use a long random string (32+ characters), e.g. `openssl rand -hex 32`.
ADMIN_TOKEN=

# Optional: persistent submission storage (Upstash Redis REST, free tier available).
# Without these, submissions are stored in memory and lost on restart/redeploy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: map tile provider. Defaults to OpenStreetMap's public tiles (light use only).
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# Optional: search engine ownership verification (meta tags in <head>).
# Google Search Console "HTML tag" content value, and Bing Webmaster Tools msvalidate.01 value.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
